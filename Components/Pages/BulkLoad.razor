@page "/bulkload"
@using attendance.Components.Models
@using attendance.Services
@using Azure;
@using Azure.Identity;
@using Azure.Core;
@using static System.Environment;
@using System.Text.Json;
@using System.Text;
@inject ILogger<BulkLoad> Logger


@inject BlazorNonceService BlazorNonceService

@attribute [StreamRendering]

<PageTitle>Bulk Loader</PageTitle>
@if (!showOutput && showButtons) {
    <h1>Paste the input data here:</h1>
    <h3>Input:</h3>
    <textarea @bind="inputData" class="form-control" rows="15" cols="120"></textarea>
    <div class="buttonRow">
        <checkbox @bind="IdentifyAdds">Identify Adds</checkbox>
        <checkbox @bind="IdentifyDeletes">Identify Deletes</checkbox>
        <button @onclick="() => makeCall()">Parse</button>
    </div>
}

@if (showOutput)
{
    <h1>Review the output data:</h1>
    <p>@statusMessage</p>
    <hr>
    <table>
        <tr><td>
            <h3>Output:</h3>
            <table>
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>ID</th>
                    </tr>
                </thead>
                <tbody>
                @if ( outputData.students == null || outputData.students.Count == 0)
                {
                    <tr><td colspan="3">No students found.</td></tr>
                }
                else {
                    foreach (var d in outputData.students)
                    {
                        <tr>
                            <td>@d.firstname</td>
                            <td>@d.lastname</td>
                            <td>@d.id</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </td>
        <td>
            <button @onclick="() => import()">Import</button>
        </td></tr>
    </table>
}

<style>
    .buttonRow {
        display: flex;
        flex-direction: row;
    }
</style>

@code {
    private string inputData = "";
    private DataList outputData = new();
    private bool showOutput = false;
    private string principalName = string.Empty;
    private string classname = string.Empty;
    private StudentClass? studentClass;
    private bool showButtons = false;
    private string statusMessage = "";
    private static List<Student> unimported = new();

    public class DataList {
        public List<BlStudent> students { get; set; } = new();
    }

    public class BlStudent {
        public string? firstname { get; set; }
        public string? lastname { get; set; }
        public string? id { get; set; }
    }

    protected override void OnInitialized()
    {
        classname = Environment.GetEnvironmentVariable("CLASSFOLDER") ?? "Classes";
        principalName = BlazorNonceService?.Nonce ?? string.Empty; 
        studentClass = new StudentClass(classname);

        var tempClassName = studentClass.lookupClassName(principalName).FirstOrDefault() ?? string.Empty;
        if (!string.IsNullOrEmpty(tempClassName))
        {
            classname = tempClassName;
            showButtons = true;
        }
    }

    private async Task makeCall() {
        string targetJson = "a JSON with key students value is array containing elements with firstname, lastname and id";
        string prompt = $"Can you pull out all of the names of enrolled students from this text. Return the results in this JSON format: {targetJson} . DATA: ";
        string escapedInputData = JsonSerializer.Serialize(inputData).Trim('"');
        
        var endpoint = new OpenaiEndpoint(Logger);
        showOutput = true;

        try 
        {
            var response = await endpoint.PostAsync2($"{prompt}{escapedInputData}");
            var responseJson = JsonSerializer.Deserialize<JsonElement>(response);
            
            if (responseJson.ValueKind == JsonValueKind.Undefined)
            {
                statusMessage = "Error: Response from the AI service is undefined.";
                Logger.LogError(statusMessage);
                return;
            }

            // Extract the actual JSON content from the response
            string? jsonContent = null;
            foreach (var property in responseJson.EnumerateObject())
            {
                if (property.Name == "Content" && property.Value.ValueKind == JsonValueKind.Array)
                {
                    var contentArray = property.Value.EnumerateArray();
                    if (contentArray.Any())
                    {
                        var firstContent = contentArray.First();
                        if (firstContent.TryGetProperty("Text", out var textElement))
                        {
                            var text = textElement.GetString() ?? string.Empty;
                            if (text.Contains("```json") && text.Contains("```"))
                            {
                                jsonContent = text
                                    .Replace("```json", "")
                                    .Replace("```", "")
                                    .Trim();
                            }
                            else
                            {
                                jsonContent = text;
                            }
                        }
                    }
                }
            }

            if (string.IsNullOrEmpty(jsonContent))
            {
                statusMessage = "Error: Could not find JSON content in the response.";
                Logger.LogError(statusMessage);
                return;
            }

            outputData = JsonSerializer.Deserialize<DataList>(jsonContent) ?? new();
            showOutput = true;
            unimported.Clear();

            foreach (var d in outputData.students)
            {
                if (d != null)
                {
                    statusMessage += ($"Found student: {d.firstname} {d.lastname} {d.id}. ");
                    unimported.Add(new Student
                    {
                        Name = $"{d.firstname} {d.lastname}".Trim(),
                        BUID = d.id ?? string.Empty
                    });
                }
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: Invalid response from the AI service: {ex.Message}";
            Logger.LogError($"{statusMessage}. Details: {ex.Message}");
        }
    }

    private async Task import()
    {
        try
        {
            var sc = new StudentClass(classname);
            var list = await sc.LoadStudentsAsync();

            if (list != null)
            {
                foreach (var newStudent in unimported)
                {
                    if (!string.IsNullOrWhiteSpace(newStudent.Name) && !string.IsNullOrWhiteSpace(newStudent.BUID))
                    {
                        list.Add(newStudent);
                    }
                }
                await sc.SaveStudentsAsync();
                statusMessage = $"Successfully imported {unimported.Count} students.";
            }
            else
            {
                statusMessage = "Error: Student list is null. Cannot import students.";
                Logger.LogError(statusMessage);
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error importing students: {ex.Message}";
            Logger.LogError($"{statusMessage}. Details: {ex.Message}");
        }
    }
}




