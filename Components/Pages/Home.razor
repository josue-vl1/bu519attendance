@page "/"

@using attendance.Components.Models
@using attendance.Services
@inject BlazorNonceService BlazorNonceService

<PageTitle>Daily attendance for @selectedDate</PageTitle>

@if (!showButtons)
{
    <h1>Unauthorized</h1>
    <p>You are not authorized to view this page.</p>
    <p>Logged in as: @principalName</p>
}
else
{

    var l1 = System.Text.Json.JsonSerializer.Serialize(students);
    var l2 = System.Text.Json.JsonSerializer.Serialize(studentClass.Students);
    <p>@l1</p>
    <p>@l2</p>
    <p>@selectedDate</p>

    <h4>Daily attendance for:
        <select @onchange="OnDateChanged">
            <option value="">Select a date</option>
            @foreach (var date in availableDates)
            {
                <option value="@date">@date.ToString("MMMM dd, yyyy")</option>
            }
        </select>
        <button @onclick="() => UpdateAttendanceAsync(selectedDate)">Save</button>
    </h4>

    @if (loading || saving)
    {
        <div
            style="height: 85px; width: 300px; background-color: bisque; border: solid 4px black; z-index: 5; position: absolute; left: 300px; top: 200px;">
            @if (loading)
            {
                <span>Loading...</span>
            }
            else if (saving)
            {
                <span>Saving...</span>
            }
        </div>
    }

    @if (showStudents)
    {
        <div class="students">
            @{
                int studentnumber = 0;
            }
            @for (int i = 0; i < 4; i++)
            {
                @for (int j = 0; j < 8; j++, studentnumber++)
                {
                    if (students[studentnumber].IsInactive)
                    {
                        continue;
                    }

                    var localStudentNumber = studentnumber; // Create a local copy of studentnumber
                    var status = students[studentnumber].Present ? "present" : "absent";
                    var deco = students[studentnumber].Present ? "style=\"border: 5px solid green\"" : "";
                    <div class="student @status" @onclick="() => TogglePresent(localStudentNumber)">
                        <img src="https://studentinfo.blob.core.windows.net/519fall2024/@(students[studentnumber].BUID).jpg" width="90"
                            height="90" style="@(students[studentnumber].Present ? "border: 5px solid green" : "");" />
                        <div class="studentinfo">
                            @students[studentnumber].Name
                            <br />
                            @students[studentnumber].BUID
                            @if (students[studentnumber].Present)
                            {
                                <div class="exempt" @onclick:stopPropagation @onclick="() => ToggleExempt(localStudentNumber)">
                                    <input type="checkbox" @bind="students[studentnumber].Exempt" />
                                    Exempt
                                </div>

                            }
                        </div>
                    </div>
                    if (studentnumber == students.Count - 1)
                    {
                        break;
                    }
                }
                if (studentnumber == students.Count - 1)
                {
                    break;
                }
            }
        </div>
    }
}


@code {

    private string selectedDate;
    private string classname="";
    private StudentClass? studentClass;
    private bool loading = false;
    private bool saving = false;
    private bool showButtons = false;
    private bool showStudents = false;
    private string allHeaders = "--init--";
    private string error = "";
    private string principalName = "foo";
    private bool pageIsInitialized = false; // Flag to track initialization

    // make a static list of dates, every monday starting on Sept 9th
    private List<DateTime> availableDates = new List<DateTime>();

    List<Student> students = new List<Student>();

    protected override async Task OnInitializedAsync()
    {

        principalName= BlazorNonceService.Nonce; 

        classname = StudentClass.lookupClassName(principalName).FirstOrDefault();
        if (classname != null)
        {
            showButtons = true;
        }

        GenerateAvailableDates();

        // Set the default date to the closest date in the list
        selectedDate = availableDates.OrderBy(x => Math.Abs((x - DateTime.Now).TotalDays)).First().ToString("yyyy-MM-dd");
        loading = true;

        studentClass = new StudentClass(classname);

        students = await studentClass.LoadStudentsAsync();
//        Task.Run(() => LoadStudentsAsync()).GetAwaiter().GetResult();
        // sort by name
        students = students.OrderBy(x => x.Name).ToList();
        loading = false;

        StateHasChanged();
    }

    // using System.Text.Encodings.Web;
    private void GenerateAvailableDates()
    {
        DateTime startDate = new DateTime(2024, 9, 9);
        for (int i = 0; i < 13; i++) // Generate dates for one year
        {
            availableDates.Add(startDate.AddDays(i * 7));
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e == null || e.Value == null) selectedDate = availableDates[0].ToString("yyyy-MM-dd");
        else selectedDate = e.Value.ToString();

        if (selectedDate == null || selectedDate == "")
        {
            showStudents = false;
            return;
        }

        //Console.WriteLine($"Selected date: {e.Value} {selectedDate}");
        loading = true;
        showStudents = false;
        //StateHasChanged();
        students = await studentClass.LoadStudentDataAsync(selectedDate);    //await LoadStudentDataAsync(selectedDate);
        loading = false;
        showStudents = true;
        //StateHasChanged();
    }

    // Save student attence data to blob storage
    private async Task UpdateAttendanceAsync(string date)
    {
        saving = true;
        StateHasChanged();
        studentClass.Students = students;
        await studentClass.SaveStudentDataAsync(date);
        saving = false;
        StateHasChanged();
    }

    void TogglePresent(int index)
    {
        //Console.WriteLine($"Index is {index}");
        students[index].Present = !students[index].Present;
        //Console.WriteLine($"{students[index].Name} is {(students[index].Present ? "present" : "absent")}");
        StateHasChanged(); // Ensure the UI is updated
    }
    void ToggleExempt(int index)
    {
        students[index].Exempt = !students[index].Exempt;
        StateHasChanged(); // Ensure the UI is updated
    }

}