@page "/"

@using Attendance.Components.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpContextAccessorService httpContextAccessorService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Daily attendance for @selectedDate</PageTitle>

<h4>Daily attendance for:  @tempData
    <select @onchange="OnDateChanged">
        @foreach (var date in availableDates)
        {
            <option value="@date">@date.ToString("MMMM dd, yyyy")</option>
        }
    </select>
    <button @onclick="() => SaveStudentDataAsync(selectedDate)">Save</button>
</h4>

@if (loading || saving)
{
<div style="height: 85px; width: 300px; background-color: bisque; border: solid 4px black; z-index: 5; position: absolute; left: 300px; top: 200px;"> 
    @if (loading)
    {
        <span>Loading...</span>
    }
    else if (saving)
    {
        <span>Saving...</span>
    }
</div>
}

<div class="students" >
    @{int studentnumber = 0;}
    @for (int i = 0; i < 4; i++)
    {
        @for (int j = 0; j < 8; j++, studentnumber++)
        {
            if (students[studentnumber].IsInactive)
            {
                continue;
            }

            var localStudentNumber = studentnumber; // Create a local copy of studentnumber
            var status = students[studentnumber].Present ? "present" : "absent";
            <div class="student @status" @onclick="() => TogglePresent(localStudentNumber)"  >
                <img src="https://studentinfo.blob.core.windows.net/519fall2024/@(students[studentnumber].BUID).jpg" width="90" height="90" style="border: 5px solid @(students[studentnumber].Present ? "green" : "red");" />
                <div class="studentinfo" >
                    @students[studentnumber].Name
                    <br />
                    @students[studentnumber].BUID
                </div>
            </div>
            if (studentnumber == students.Count - 1)
            {
                break;
            }
        }
        if (studentnumber == students.Count - 1)
        {
            break;
        }
    }
</div>


@code {

    private string selectedDate;
    private bool loading = false;
    private bool saving = false;
    private string tempData = "";
    // make a static list of dates, every monday starting on Sept 9th
    private List<DateTime> availableDates = new List<DateTime>();

    List<Student> students = new List<Student>();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        GenerateAvailableDates();

        // Set the default date to the closest date in the list
        selectedDate = availableDates.OrderBy(x => Math.Abs((x - DateTime.Now).TotalDays)).First().ToString("yyyy-MM-dd");
        loading = true;
        Task.Run(() => LoadStudentsAsync()).GetAwaiter().GetResult();
        // sort by name
        students = students.OrderBy(x => x.Name).ToList();
        loading = false;


        //Console.WriteLine("Checking user permissions " + httpContextAccessorService());
        var principalName = httpContextAccessorService.GetHeader("X-MS-CLIENT-PRINCIPAL-NAME");
        
         Console.WriteLine ("checking user :" + principalName);
        tempData = principalName;
        //if (principalName=="nagendra@bu.edu" || principalName=="langd0n@bu.edu" || principalName=="matzh@bu.edu") {
        //    showButtons = true;
       // }
    }

//    using System.Text.Encodings.Web;
    private void GenerateAvailableDates()
    {
        DateTime startDate = new DateTime(2024, 9, 9);
        for (int i = 0; i < 13; i++) // Generate dates for one year
        {
            availableDates.Add(startDate.AddDays(i * 7));
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e == null || e.Value == null) selectedDate = availableDates[0].ToString("yyyy-MM-dd");
        else selectedDate = e.Value.ToString();

        loading = true;
        StateHasChanged();
        await LoadStudentDataAsync(selectedDate);
        loading = false;
        StateHasChanged();
    }

    private async Task LoadStudentsAsync()
    {
        var blobUri = new Uri($"https://studentinfo.blob.core.windows.net/519fall2024/students.json");

        try {
            var credential = new Azure.Identity.DefaultAzureCredential();
            var blobClient = new Azure.Storage.Blobs.BlobClient(blobUri, credential);

            var response = await blobClient.DownloadAsync();
            using (var streamReader = new StreamReader(response.Value.Content))
            {
                var jsonData = await streamReader.ReadToEndAsync();
                students = System.Text.Json.JsonSerializer.Deserialize<List<Student>>(jsonData) ?? new List<Student>();
            }

            //Console.WriteLine("Data loaded successfully");
        }
        catch (Exception e) {
            Console.WriteLine($"Error loading student data: {e.Message}");
        }
    }

    // Save student attence data to blob storage
    private async Task SaveStudentDataAsync(string date)
    {
        saving = true;
        StateHasChanged();
        date = System.Text.Encodings.Web.UrlEncoder.Default.Encode(date) + ".json";
        var blobUri = new Uri($"https://studentinfo.blob.core.windows.net/519fall2024/{date}");

        try {
            var jsonData = System.Text.Json.JsonSerializer.Serialize(students.Select(x => new StudentData { BUID = x.BUID, Present = x.Present }).ToList());

            var credential = new Azure.Identity.DefaultAzureCredential();
            var blobClient = new Azure.Storage.Blobs.BlobClient(blobUri, credential);

            using (var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(jsonData)))
            {
                //Console.WriteLine("Uploading data to blob storage");
                await blobClient.UploadAsync(stream, overwrite: true);
                //Console.WriteLine("Data saved successfully");
            }

        }
        catch (Exception e) {
            Console.WriteLine($"Error saving student data: {e.Message}");
        }
        saving = false;
        StateHasChanged();

    }
    // Load student attence data from blob storage
    private  async Task LoadStudentDataAsync(string date)
    {
        date = System.Text.Encodings.Web.UrlEncoder.Default.Encode(date) + ".json";
        //Console.WriteLine($"Loading student data for {date}");
        using (var httpClient = new HttpClient())
        {
            bool responseFound = false;
            try {
                var blobUri = new Uri($"https://studentinfo.blob.core.windows.net/519fall2024/{date}");
                //Console.WriteLine($"Blob URI: {blobUri}");

                var response = await httpClient.GetAsync(blobUri.ToString());
                
                if (response.IsSuccessStatusCode)
                {
                    var attendance = await response.Content.ReadFromJsonAsync<List<StudentData>>();
                    if (attendance != null)
                    {
                        responseFound = true;
                        foreach (var student in attendance) {
                            var index = students.FindIndex(x => x.BUID == student.BUID);
                            if (index != -1) {
                                students[index].Present = student.Present;
                            }
                        }
                    }
                }
            }
            catch (Exception e) {
                Console.WriteLine($"Error loading student data: {e.Message}");
            }

            if (!responseFound)  {
                foreach (var student in students) {
                    student.Present = false;
                }
            }
        }
    }


    void TogglePresent(int index)
    {
        //Console.WriteLine($"Index is {index}");
        students[index].Present = !students[index].Present;
        //Console.WriteLine($"{students[index].Name} is {(students[index].Present ? "present" : "absent")}");
        StateHasChanged(); // Ensure the UI is updated
    }

