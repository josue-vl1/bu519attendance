@page "/manage"
@using attendance.Components.Models
@using attendance.Services
@inject BlazorNonceService BlazorNonceService

@attribute [StreamRendering]

<PageTitle>Manage Students</PageTitle>

@if (!showButtons)
{
    <h1>Unauthorized</h1>
    <p>You are not authorized to view this page.</p>
}
else
{
    <h1>Students</h1>


    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>BUID</th>
                <th>Inactive</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in students)
            {
                <tr>
                    <td>
                        @if (student.IsEditing)
                        {
                            <input @bind="student.Name" class="form-control" />
                        }
                        else
                        {
                            @student.Name
                        }
                    </td>
                    <td>
                        @if (student.IsEditing)
                        {
                            <input @bind="student.BUID" class="form-control" />
                        }
                        else
                        {
                            @student.BUID
                        }
                    </td>
                    <td>
                        @if (student.IsEditing)
                        {
                            <input type="checkbox" @bind="student.IsInactive" />
                        }
                        else
                        {
                            <input type="checkbox" checked="@student.IsInactive" disabled />
                        }
                    </td>
                    <td>
                        <a href="#" @onclick:preventDefault @onclick="() => ToggleEditAsync(student)">
                            @(student.IsEditing ? "Save" : "Edit")
                        </a>
                    </td>
                </tr>
            }
            <tr>
                <td>
                    <input @bind="newStudent.Name" class="form-control" placeholder="New Name" />
                </td>
                <td>
                    <input @bind="newStudent.BUID" class="form-control" placeholder="New BUID" />
                </td>
                <td>
                    <button @onclick="AddStudentAsync" class="btn btn-primary">Add</button>
                </td>
            </tr>

        </tbody>
    </table>

    @if (loading || saving)
    {
        <div
            style="height: 85px; width: 300px; background-color: bisque; border: solid 4px black; z-index: 5; position: absolute; left: 300px; top: 200px;">
            @if (loading)
            {
                <span>Loading...</span>
            }
            else if (saving)
            {
                <span>Saving...</span>
            }
        </div>
    }
}

@code {
    private bool loading = false;
    private string classname = "";
    private bool saving = false;
    private bool showButtons = false;
    private string principalName = "foo";
    private bool error = false;
    private StudentClass? studentClass;


    private Student newStudent = new Student();
    List<Student> students = new List<Student>();

    protected override async Task OnInitializedAsync()
    {
        principalName = BlazorNonceService.Nonce;
        classname = StudentClass.lookupClassName(principalName).First();

        studentClass = new StudentClass(classname);
        loading = true;
        students = await studentClass.LoadStudentsAsync();
        loading = false;

        // sort by name
        students = students.OrderBy(x => x.Name).ToList();
        StateHasChanged();
    }

    private async Task ToggleEditAsync(Student student)
    {
        student.IsEditing = !student.IsEditing;
        if (!student.IsEditing)
        {
            await SerializeStudentsAsync();
        }
    }

    private async Task AddStudentAsync()
    {
        if (!string.IsNullOrWhiteSpace(newStudent.Name) && !string.IsNullOrWhiteSpace(newStudent.BUID))
        {
            students.Add(new Student { Name = newStudent.Name, BUID = newStudent.BUID });
            newStudent = new Student(); // Reset the new student entry
            await SerializeStudentsAsync();
        }
    }

    private async Task SerializeStudentsAsync()
    {
        saving = true;
        await studentClass.SaveStudentsAsync();
        saving = false;
    }



}
