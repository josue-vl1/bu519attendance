@page "/report"
@using System.Globalization
@using attendance.Components.Module
@using attendance.Components.Models
@using attendance.Services
@inject BlazorNonceService BlazorNonceService

<PageTitle>Report</PageTitle>
<div class="sidexside">
    <div class="cals">
        <CalendarMonth Month="1" Year="2025" class="cal" HighlightedDates="highlightedDates"
            OnDateClick="HandleDateClick" />
        <CalendarMonth Month="2" Year="2025" class="cal" HighlightedDates="highlightedDates"
            OnDateClick="HandleDateClick" />
        <CalendarMonth Month="3" Year="2025" class="cal" HighlightedDates="highlightedDates"
            OnDateClick="HandleDateClick" />
        <CalendarMonth Month="4" Year="2025" class="cal" HighlightedDates="highlightedDates"
            OnDateClick="HandleDateClick" />
    </div>
    <div class="data">
        <h3>Attendance Report for @classname</h3>
        <button @onclick="calculateAttendance">Calculate Attendance</button>

        @if (showReport)
        {
            <p>Total Classes: @totalClasses</p>
        
            <table>
                <tbody>
                    <tr>
                        <th>Student ID</th>
                        <th>Student Name</th>
                        <th>Days Attended</th>
                    </tr>
                    @{
                        foreach (var studentID in studentAttendance.Keys)
                        {
                            var student = studentAttendance[studentID];
                            <tr>
                                <td>@studentID</td>
                                <td>@student.StudentName</td>
                                <td>@student.DaysAttended </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {

    private string principalName = string.Empty;
    private string classname = string.Empty;
    private bool showReport = false;
    private StudentClass? studentClass;
    private List<DateOnly> highlightedDates = new List<DateOnly>();

    private Dictionary<string, StudentAttendance> studentAttendance = new Dictionary<string, StudentAttendance>();
    private Dictionary<string, string> studentNames = new Dictionary<string, string>();
    private int totalClasses = 0;

    protected override void OnInitialized()
    {
        principalName = BlazorNonceService.Nonce ?? String.Empty;
        principalName = "nagendra@bu.edu";
        classname = StudentClass.lookupClassName(principalName).FirstOrDefault() ?? String.Empty;
        classname = "519spring2025";
        studentClass = new StudentClass(classname);
        if (classname != null)
        {

            highlightedDates = StudentClass.getSchedule(classname);

            @* foreach (var date in highlightedDates)
            {
                Console.WriteLine(date);
            } *@
        }
    }

    private void HandleDateClick(DateTime date)
    {
        Console.WriteLine($"Date clicked: {date}");
        // Add your logic here to handle the date click event
    }


    private async Task calculateAttendance()
    {
        if (studentClass == null)
        {
            return;
        } 
        Console.WriteLine("Calculating attendance");
        showReport = true;

        Dictionary<DateOnly, Dictionary<string, bool>> attendanceRecords = new Dictionary<DateOnly, Dictionary<string, bool>>();
        Dictionary<string, bool> StudentIds = new Dictionary<string, bool>();
        List<string> students = new List<string>();

        @* Console.WriteLine ("Checking attendance for each date"); *@
        var allStudentList = new List<Student>();

        allStudentList = await studentClass.LoadStudentsAsync();

        // Set attendance to 0 for each student
        foreach (var student in allStudentList)
        {
            studentAttendance[student.BUID]= new StudentAttendance { DaysAttended = 0, StudentName = student.Name };
        }

        foreach (var date in highlightedDates)
        {
            @* Console.WriteLine($"Checking attendance for {date}"); *@
            var datestr = date.ToString("MMMddyyyy");
            var attendance = await studentClass.LoadStudentDataAsync(datestr);

            @* Console.WriteLine($"Attendance for {date} has {attendance.Count} students"); *@
 
            // update student's attendance in the list
            foreach (var student in attendance)
            {
                if (studentAttendance.ContainsKey(student.BUID))
                {
                    studentAttendance[student.BUID].DaysAttended += student.Present ? 1 : 0;
                }
                else
                {
                    studentAttendance[student.BUID] = new StudentAttendance { DaysAttended = student.Present ? 1 : 0 };
                }
                @* Console.WriteLine($"Student {student.BUID} has attended {studentAttendance[student.BUID]} classes"); *@
            }
 
        }

        @* foreach (var student in allStudentList)
        {
            if (!studentAttendance.ContainsKey(student.BUID))
            {
                studentAttendance[student.BUID].StudentName = student.Name;
            }
        } *@

        // Calculate the total number of classes
        totalClasses = highlightedDates.Count;

    }
}